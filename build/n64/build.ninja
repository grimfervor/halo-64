# generated by tools/n64_build.py - do not edit
builddir = build/n64
root = /home/grimf/Documents/GitHub/halo-64
bin = /home/grimf/n64/toolchain/bin
n64inst = /home/grimf/n64/toolchain
cc = /home/grimf/n64/toolchain/bin/mips64-elf-gcc
python = /usr/bin/python3
definitions = $
    /home/grimf/Documents/GitHub/halo-64/dependencies/invader/src/tag/hek/definition

rule cc
  command = cd $root && $cc -MMD -MF $out.d $cflags -c $in -o $out
  description = N64 CC $in
  depfile = $out.d
  deps = gcc
rule semantics
  command = cd $root && $python tools/linux_msvc_semantics.py --output $out $
      $scan
  description = N64 MSVC SEMANTICS $out
  restat = 1
rule link
  command = cd $root && export N64_INST=$n64inst && $cc -march=vr4300 $
      -mtune=vr4300 -mabi=o64 -g -o $out @$out.rsp -L$libdir $ldlibs -lc $
      -Wl,-L$libdir -Wl,-Tn64.ld -Wl,--gc-sections $
      -Wl,--wrap,__do_global_ctors -Wl,-Map=$out.map $ldflags && $python $
      tools/n64_link_check.py $objlist --check
  description = N64 LINK $out
  rspfile = $out.rsp
  rspfile_content = $in_newline
rule program
  command = cd $root && export N64_INST=$n64inst && $bin/n64sym --all $in $
      $in.sym && cp $in $in.stripped && $bin/mips64-elf-strip -s $
      $in.stripped && $bin/n64elfcompress -o $outdir -c $
      $rom_elf_compression $in.stripped
  description = N64 PROGRAM $in
rule dso_link
  command = cd $root && $bin/mips64-elf-ld --emit-relocs $
      --unresolved-symbols=ignore-all --nmagic --gc-sections -u $export $
      -T$libdir/dso.ld -Map=$out.map -o $out $in
  description = N64 MODULE LINK $out
rule dso
  command = cd $root && export N64_INST=$n64inst && $bin/n64dso -o $outdir $
      -c 0 $in
  description = N64 MODULE $out
rule dso_extern
  command = cd $root && export N64_INST=$n64inst && $bin/n64dso-extern -o $
      $out $in
  description = N64 MODULE IMPORTS $out
rule msym
  command = cd $root && export N64_INST=$n64inst && $bin/n64dso-msym -e $
      $externs $in $out
  description = N64 PROGRAM SYMBOLS $out
rule copy
  command = cd $root && mkdir -p $$(dirname $out) && cp $in $out
  description = N64 COPY $out
rule z64
  command = cd $root && export N64_INST=$n64inst $
      INVADER_DEFINITIONS=$definitions && $bin/n64sym --all $in $in.sym && $
      cp $in $in.stripped && $bin/mips64-elf-strip -s $in.stripped && $
      $bin/n64elfcompress -o $outdir -c $rom_elf_compression $in.stripped $
      && $bin/n64tool --toc --title "$title" --output $out.tmp --align 256 $
      $in.stripped $in.sym $msym $extra && $bin/ed64romconfig $
      --expansionpak required --savetype eeprom4k --regionfree $out.tmp && $
      mv $out.tmp $out
  description = N64 ROM $out

