    build/n64/custom/halo.externs
  libdir = /home/grimf/n64/toolchain/mips64-elf/lib
  objlist = build/n64/custom/objects.txt
  ldlibs =  /home/grimf/n64/tiny3d/build/libt3d.a -ldragon -lm -ldragonsys
  ldflags = -Wl,--wrap,malloc_uncached -Wl,--wrap,malloc_uncached_aligned $
      -Wl,--wrap,free_uncached -Wl,--wrap,console_init -Wl,--wrap,rspq_wait $
      -flto=4 -Os -G8 -mfix4300 -falign-jumps=1 -falign-loops=1 $
      -falign-labels=1 -Wl,-Tbuild/n64/custom/halo.externs
build build/n64/custom/halo.msym: msym build/n64/custom/halo.elf | $
    build/n64/custom/halo.externs
  externs = build/n64/custom/halo.externs
build build/n64/custom/halo.elf.stripped build/n64/custom/halo.elf.sym: $
    program build/n64/custom/halo.elf | $
    /home/grimf/n64/toolchain/bin/n64sym $
    /home/grimf/n64/toolchain/bin/mips64-elf-strip $
    /home/grimf/n64/toolchain/bin/n64elfcompress
  outdir = build/n64/custom
  rom_elf_compression = 1
build custom: phony build/n64/custom/halo.elf.stripped $
    build/n64/custom/halo.elf.sym build/n64/custom/hud64.dso $
    build/n64/custom/halo.msym
default build/n64/halo.z64 build/n64/halo-campaign.z64
