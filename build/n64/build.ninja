pool convert
  depth = 3
rule convert_map
  command = cd $root && export N64_INST=$n64inst $
      INVADER_DEFINITIONS=$definitions && $python -m tools.n64.convert $in $
      -o $map --filesystem $fsdir $convert_flags && $python -m $
      tools.n64.compress_map $map --backup $map_backup
  description = N64 MAP $out
  pool = convert
rule convert_ui
  command = cd $root && export N64_INST=$n64inst $
      INVADER_DEFINITIONS=$definitions && $python -m tools.n64.ui $in $
      --filesystem $fsdir
  description = N64 MENU $out
  pool = convert
rule convert_music
  command = cd $root && export INVADER_DEFINITIONS=$definitions && $python $
      -m tools.n64.music $in --filesystem $fsdir
  description = N64 MUSIC $out
  pool = convert
rule sound_bank
  command = cd $root && $python -m tools.n64.soundbank $variantdir $fsdir $
      $maps
  description = N64 SOUNDS $out
rule touch
  command = cd $root && mkdir -p $$(dirname $out) && : > $out
  description = N64 FLAG $out
rule mkdfs
  command = cd $root && $python -m tools.n64.prune $fsdir $maps && $
      $bin/mkdfs $out $fsdir > /dev/null && : $in $flags
  description = N64 DFS $out
rule mkdfs_packed
  command = cd $root && $bin/mkdfs $out $fsdir > /dev/null && : $in $flags
  description = N64 PC DFS $out
pool pack
  depth = 1
rule fx_pool
  command = cd $root && $python -m tools.n64.fx_pool --filesystem $
      $source_fs --output $packed_fs --maps $maps --stamp $stamp
  description = N64 PC SHARED FX $packed_fs
  pool = pack
  restat = 1
rule paint_masks
  command = cd $root && export INVADER_DEFINITIONS=$definitions && $python $
      -m tools.n64.paint_masks --map $source_map --output $out
  description = N64 PAINT $out
rule decal_bank
  command = cd $root && export INVADER_DEFINITIONS=$definitions && $python $
      -m tools.n64.decal_bank --maps $sources --output $out $convert_flags
  description = N64 DECALS $out
  pool = convert
rule pc_thumbnails
  command = cd $root && export N64_INST=$n64inst $
      INVADER_DEFINITIONS=$definitions && $python -m $
      tools.n64.pc_thumbnails --bitmap $bitmap --output $outputdir
  description = N64 PC MAP PICTURES
build build/n64/obj/source/cseries/headers.o: cc source/cseries/headers.c | $
    build/n64/halo_msvc_semantics.h
  cflags = -march=vr4300 -mtune=vr4300 -mabi=o64 -G8 -fms-extensions $
      -fshort-wchar -fcommon -fno-strict-aliasing -fwrapv $
      -fno-delete-null-pointer-checks -freg-struct-return -ffp-contract=off $
      -fno-math-errno -fsigned-char -ffunction-sections -fdata-sections $
      -falign-functions=32 -mfix4300 -falign-jumps=1 -falign-loops=1 $
      -falign-labels=1 -g -fno-builtin-wcslen -fno-builtin-wcsnlen $
      -fno-builtin-wcschr -fno-builtin-wcsrchr -fno-builtin-wcscmp $
      -fno-builtin-wcsncmp -fno-builtin-wcscpy -fno-builtin-wcsncpy $
